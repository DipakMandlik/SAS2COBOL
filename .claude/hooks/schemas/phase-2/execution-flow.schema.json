{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionFlow",
  "type": "object",
  "required": ["executionSteps"],
  "properties": {
    "executionSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stepNumber", "stepName", "programOrUtility", "inputs", "outputs"],
        "properties": {
          "stepNumber": { "type": "integer", "minimum": 1 },
          "stepName": { "type": "string" },
          "programOrUtility": { "type": "string" },
          "inputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "outputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "conditionCodeHandling": { "type": "string" }
        }
      }
    }
  }
}
