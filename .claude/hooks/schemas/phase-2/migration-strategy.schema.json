{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MigrationStrategy",
  "type": "object",
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decisionId", "stepId", "sourceComponent", "strategy", "targetPattern", "confidence"],
        "properties": {
          "decisionId": { "type": "string" },
          "stepId": { "type": "string" },
          "sourceComponent": { "type": "string" },
          "strategy": {
            "type": "string",
            "enum": [
              "DIRECT_TRANSLATION",
              "STRUCTURED_REWRITE",
              "PROC_DECOMPOSITION",
              "SQL_TO_DATA_PROCESSING",
              "DATA_STEP_TO_SEQUENTIAL_PROCESSING",
              "DATA_STEP_TO_SORT_AND_GROUP",
              "DFSORT_UTILITY_STEP",
              "MANUAL_REVIEW_REQUIRED"
            ]
          },
          "targetPattern": { "type": "string" },
          "requiresDecomposition": { "type": "boolean" },
          "rationale": { "type": "string" },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
        }
      }
    }
  }
}
