{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phase1ReviewReport",
  "type": "object",
  "required": ["reviewId", "reviewer", "reviewedArtifacts", "findings", "traceabilityAssessment", "referentialIntegrityAssessment", "uncertaintyAssessment", "overallDisposition", "blockers"],
  "properties": {
    "reviewId": { "type": "string", "pattern": "^REV-[0-9A-Za-z_-]+$" },
    "reviewer": {
      "type": "object",
      "required": ["agent", "timestamp"],
      "properties": {
        "agent": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "reviewedArtifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["findingId", "severity", "component", "issue", "evidence", "recommendation", "status"],
        "properties": {
          "findingId": { "type": "string" },
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"] },
          "component": { "type": "string" },
          "issue": { "type": "string" },
          "evidence": { "type": "string" },
          "recommendation": { "type": "string" },
          "status": { "type": "string", "enum": ["OPEN", "RESOLVED", "WAIVED"] }
        }
      }
    },
    "traceabilityAssessment": {
      "type": "object",
      "required": ["status", "coveragePercentage"],
      "properties": {
        "status": { "type": "string", "enum": ["COMPLETE", "INCOMPLETE"] },
        "coveragePercentage": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "referentialIntegrityAssessment": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["PASSED", "FAILED"] }
      }
    },
    "uncertaintyAssessment": {
      "type": "object",
      "required": ["openCriticalCount", "status"],
      "properties": {
        "openCriticalCount": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "enum": ["ACCEPTABLE", "BLOCKED"] }
      }
    },
    "overallDisposition": {
      "type": "string",
      "enum": ["APPROVED", "APPROVED_WITH_CONDITIONS", "REJECTED"]
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
