{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SASTrapsLedger",
  "type": "object",
  "required": ["traps"],
  "properties": {
    "traps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trapId", "stepId", "category", "line", "description", "mitigation"],
        "properties": {
          "trapId": { "type": "string", "pattern": "^TRAP-[0-9A-Za-z_-]+$" },
          "stepId": { "type": "string" },
          "category": {
            "type": "string",
            "enum": [
              "MISSING_VALUE_COMPARISON",
              "SPECIAL_MISSING_VALUES",
              "IMPLICIT_RETAIN",
              "TYPE_COERCION",
              "MERGE_WITHOUT_BY",
              "DUPLICATE_KEY_CARDINALITY",
              "IN_FLAG_INDICATORS",
              "PDV_RESET_ANOMALY",
              "DATE_EPOCH_OFFSET",
              "FIRST_LAST_GROUPING",
              "MULTIPLE_SET_STATEMENTS",
              "AUTOMATIC_VARIABLES",
              "IMPLICIT_VS_EXPLICIT_OUTPUT",
              "FORMAT_VS_INFORMAT_CONVERSION",
              "WORK_DATASET_OVERWRITE",
              "PROC_GENERATED_VARIABLES",
              "SQL_NULL_VS_MISSING",
              "MACRO_DYNAMIC_EXECUTION",
              "EXTERNAL_DATA_BOUNDARY"
            ]
          },
          "line": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "mitigation": { "type": "string" }
        }
      }
    }
  }
}
