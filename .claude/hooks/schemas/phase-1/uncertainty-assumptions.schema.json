{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UncertaintyAndAssumptionsRegister",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "stepId", "description", "impact", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^(UNC|ASM|REV|BLK)-[0-9A-Za-z_-]+$" },
          "kind": {
            "type": "string",
            "enum": [
              "UNCERTAINTY",
              "ASSUMPTION",
              "REQUIRES_REVIEW",
              "DYNAMIC_UNRESOLVED",
              "PARTIAL_SCHEMA_UNKNOWN",
              "UNSUPPORTED",
              "BLOCKED"
            ]
          },
          "stepId": { "type": "string" },
          "description": { "type": "string" },
          "impact": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
          },
          "status": {
            "type": "string",
            "enum": ["OPEN", "CONFIRMED", "RESOLVED", "KNOWN", "INFERRED"]
          }
        }
      }
    }
  }
}
