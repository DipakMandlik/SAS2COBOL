/* Synthetic Match-Merge test fixture */
DATA WORK.CUSTOMER_SUMMARY;
    MERGE LIB.CUSTOMERS (IN=INCUST)
          LIB.BALANCES (IN=INBAL);
    BY CUSTOMER_ID;
    RETAIN CUMULATIVE_SPEND 0;

    IF INCUST AND INBAL THEN DO;
        CUMULATIVE_SPEND = CUMULATIVE_SPEND + CURRENT_BALANCE;
        OUTPUT;
    END;
RUN;
